<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="horizontal">

    <!-- 左侧导航栏 -->
    <LinearLayout
        android:layout_width="@dimen/rail_width"
        android:layout_height="match_parent"
        android:background="@drawable/bg_rail_panel"
        android:orientation="vertical"
        android:paddingStart="@dimen/rail_pad_h"
        android:paddingTop="@dimen/rail_pad_top"
        android:paddingEnd="@dimen/rail_pad_h"
        android:paddingBottom="@dimen/rail_pad_bottom">

        <TextView
            android:id="@+id/brand"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:letterSpacing="0.04"
            android:text="剧好看"
            android:textColor="@color/accent"
            android:textSize="@dimen/brand_size"
            android:textStyle="bold" />

        <View
            android:layout_width="22dp"
            android:layout_height="2dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:background="@color/accent" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="@dimen/brand_sub_margin_bottom"
            android:gravity="center"
            android:letterSpacing="0.12"
            android:text="回归纯粹光影"
            android:textColor="#5A6875"
            android:textSize="@dimen/brand_sub_size" />

        <!-- 菜单可滚动，小屏/横屏下不会显示不全；每项等分高度 -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/navList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/navSearch"
                    style="@style/NavItem"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawableStart="@drawable/ic_search"
                    android:text="@string/nav_search" />

                <TextView
                    android:id="@+id/navLive"
                    style="@style/NavItem"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawableStart="@drawable/ic_live"
                    android:text="@string/nav_live" />

                <TextView
                    android:id="@+id/navMovie"
                    style="@style/NavItem"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawableStart="@drawable/ic_movie"
                    android:text="@string/nav_movie" />

                <TextView
                    android:id="@+id/navTv"
                    style="@style/NavItem"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawableStart="@drawable/ic_tv"
                    android:text="@string/nav_tv" />

                <TextView
                    android:id="@+id/navAnime"
                    style="@style/NavItem"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawableStart="@drawable/ic_anime"
                    android:text="@string/nav_anime" />

                <TextView
                    android:id="@+id/navShow"
                    style="@style/NavItem"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawableStart="@drawable/ic_show"
                    android:text="@string/nav_show" />

                <TextView
                    android:id="@+id/navReplay"
                    style="@style/NavItem"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawableStart="@drawable/ic_replay"
                    android:text="@string/nav_continue" />

                <TextView
                    android:id="@+id/navFavorite"
                    style="@style/NavItem"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawableStart="@drawable/ic_favorite"
                    android:text="@string/nav_favorite" />

                <TextView
                    android:id="@+id/navSettings"
                    style="@style/NavItem"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawableStart="@drawable/ic_settings"
                    android:text="@string/nav_settings" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clipChildren="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:orientation="vertical"
            android:paddingStart="@dimen/content_pad_h"
            android:paddingTop="@dimen/content_pad_top"
            android:paddingEnd="@dimen/content_pad_h"
            android:paddingBottom="@dimen/content_pad_bottom">

            <!-- 标题 + 时间 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/pageTitle"
                        style="@style/TextTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.02"
                        android:text="@string/nav_movie"
                        android:textSize="@dimen/page_title_size" />

                    <TextView
                        android:id="@+id/pageSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:letterSpacing="0.04"
                        android:textColor="@color/text2"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/clockTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.06"
                        android:textColor="@color/text"
                        android:textSize="@dimen/clock_size"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/clockDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:letterSpacing="0.04"
                        android:textColor="#6C7A88"
                        android:textSize="@dimen/clock_date_size" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="12dp"
                android:background="@color/line" />

            <HorizontalScrollView
                android:id="@+id/chipScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/chipRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <HorizontalScrollView
                android:id="@+id/subScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/subRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/grid"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="10dp"
                android:layout_weight="1"
                android:clipChildren="true"
                android:clipToPadding="true"
                android:paddingTop="6dp"
                android:paddingBottom="24dp"
                android:scrollbars="none" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/loading"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/accent" />

        <TextView
            android:id="@+id/emptyText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/empty"
            android:textColor="@color/text2"
            android:textSize="16sp"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/filterOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/filterPanel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_dropdown"
                android:elevation="18dp"
                android:orientation="vertical"
                android:padding="7dp">

                <ScrollView
                    android:id="@+id/filterScrollView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/filterOptions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </ScrollView>
            </LinearLayout>
        </FrameLayout>
    </FrameLayout>
</LinearLayout>
