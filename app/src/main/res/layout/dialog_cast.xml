<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_cast_panel"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="22dp"
    android:paddingEnd="24dp"
    android:paddingBottom="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:contentDescription="投屏"
            android:src="@drawable/ic_cast"
            android:tint="@color/accent" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="投屏"
            android:textColor="@color/text"
            android:textSize="21sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/castSub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="选择要投屏的设备，播放画面将同步到电视"
        android:textColor="@color/text2"
        android:textSize="13sp" />

    <!-- 搜索中 -->
    <LinearLayout
        android:id="@+id/castSearching"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingTop="14dp"
        android:paddingBottom="14dp">

        <ProgressBar
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:indeterminateTint="@color/accent" />

        <TextView
            android:id="@+id/castSearchingText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="正在搜索同一局域网内的电视…"
            android:textColor="@color/text2"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- 已连接：显示真实设备名与「已连接」状态，不再显示搜索动效 -->
    <LinearLayout
        android:id="@+id/castConnected"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_cast_item"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="14dp"
        android:paddingEnd="14dp"
        android:paddingBottom="14dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:contentDescription="已连接设备"
            android:src="@drawable/ic_tv"
            android:tint="@color/accent" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/castConnectedName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="电视"
                android:textColor="@color/text"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="正在投屏到这台电视"
                android:textColor="@color/text2"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/castConnectedBadge"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:background="@drawable/bg_cast_ok"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="已连接"
            android:textColor="@color/accent"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- 已断开：不自动重连、不自动再搜，等用户点「重新搜索」 -->
    <LinearLayout
        android:id="@+id/castDisconnected"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/castDisconnectedText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="投屏已断开"
            android:textColor="@color/text"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/castDisconnectedTip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="需要继续投屏时，点「重新搜索」重新发现设备"
            android:textColor="@color/text2"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- 未发现设备 -->
    <LinearLayout
        android:id="@+id/castEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:alpha="0.5"
            android:contentDescription="未发现设备"
            android:src="@drawable/ic_tv"
            android:tint="@color/text2" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="未发现投屏设备"
            android:textColor="@color/text"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="center"
            android:text="请确认电视与手机连在同一个 Wi-Fi，并已开启电视的「投屏 / 多屏互动 / DLNA」功能"
            android:textColor="@color/text2"
            android:textSize="12sp" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/castListScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/castList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="end"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/castStop"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_cast_action"
            android:clickable="true"
            android:focusable="true"
        android:focusableInTouchMode="true"
            android:gravity="center"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:text="停止投屏"
            android:textColor="@color/danger"
            android:textSize="14sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/castRefresh"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_cast_action"
            android:clickable="true"
            android:focusable="true"
        android:focusableInTouchMode="true"
            android:gravity="center"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:text="重新搜索"
            android:textColor="@color/text"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/castClose"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/bg_cast_action"
            android:clickable="true"
            android:focusable="true"
        android:focusableInTouchMode="true"
            android:gravity="center"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:text="关闭"
            android:textColor="@color/text"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
