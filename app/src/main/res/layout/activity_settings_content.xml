<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/settings_pad_h"
        android:paddingTop="@dimen/settings_pad_top"
        android:paddingEnd="@dimen/settings_pad_h"
        android:paddingBottom="48dp">

        <!-- 顶栏：标题 + 返回 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.03"
                    android:text="设置"
                    android:textColor="@color/text"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="账号、播放与直播偏好"
                    android:textColor="@color/text2"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip"
                android:focusable="true"
                android:paddingStart="16dp"
                android:paddingTop="8dp"
                android:paddingEnd="16dp"
                android:paddingBottom="8dp"
                android:text="返回"
                android:textColor="@color/chip_text"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- 账号 -->
        <TextView
            style="@style/SettingGroupTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/settings_group_gap"
            android:layout_marginBottom="8dp"
            android:text="账号" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_setting_card"
            android:orientation="vertical"
            android:padding="6dp">

        <LinearLayout
            android:id="@+id/btnServers"
            style="@style/SettingRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_account" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/SettingTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="账号与服务器" />

                <TextView
                    style="@style/SettingSub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="管理登录服务器与账号" />
            </LinearLayout>

            <TextView
                android:id="@+id/valServers"
                style="@style/SettingValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="200dp"
                android:text="未配置" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="4dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_chevron" />
        </LinearLayout>

        <!-- 未配置服务器时的新增表单 -->
        <LinearLayout
            android:id="@+id/serverSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/labelServerName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="服务器名称"
                android:textColor="@color/text2"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/editServerName"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input"
                android:hint="例如：家里 NAS / 公司服务器"
                android:inputType="text"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:singleLine="true"
                android:textColor="@color/text"
                android:textColorHint="@color/text2"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/labelServerAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="服务器地址"
                android:textColor="@color/text2"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/editServer"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input"
                android:inputType="textUri"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:singleLine="true"
                android:textColor="@color/text"
                android:textColorHint="@color/text2"
                android:textSize="15sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="账号"
                        android:textColor="@color/text2"
                        android:textSize="12sp" />

                    <EditText
                        android:id="@+id/editUser"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="6dp"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/bg_input"
                        android:inputType="text"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:singleLine="true"
                        android:textColor="@color/text"
                        android:textSize="15sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="密码"
                        android:textColor="@color/text2"
                        android:textSize="12sp" />

                    <EditText
                        android:id="@+id/editPass"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_input"
                        android:inputType="textPassword"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:singleLine="true"
                        android:textColor="@color/text"
                        android:textSize="15sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/settingsStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="@color/accent"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/btnLogin"
                style="@style/ActionButtonPrimaryCompact"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="测试并登录" />
        </LinearLayout>
        </LinearLayout>

        <!-- 播放 -->
        <TextView
            style="@style/SettingGroupTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/settings_group_gap"
            android:layout_marginBottom="8dp"
            android:text="播放" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_setting_card"
            android:orientation="vertical"
            android:padding="6dp">

            <LinearLayout
                android:id="@+id/btnSpeed"
                style="@style/SettingRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_speed" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/SettingTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="默认倍速" />

                    <TextView
                        style="@style/SettingSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="新打开的影片使用该倍速" />
                </LinearLayout>

                <TextView
                    android:id="@+id/valSpeed"
                    style="@style/SettingValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="正常" />

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="4dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chevron" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="46dp"
                android:layout_marginEnd="10dp"
                android:background="@color/line" />

            <LinearLayout
                android:id="@+id/btnAdblock"
                style="@style/SettingRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_adblock" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/SettingTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="去广告" />

                    <TextView
                        style="@style/SettingSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="自动跳过网页播放广告" />
                </LinearLayout>

                <View
                    android:id="@+id/swAdblock"
                    android:layout_width="44dp"
                    android:layout_height="24dp"
                    android:background="@drawable/bg_switch_off" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="46dp"
                android:layout_marginEnd="10dp"
                android:background="@color/line" />

            <LinearLayout
                android:id="@+id/btnAutoNext"
                style="@style/SettingRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_autoplay" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/SettingTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="自动连播" />

                    <TextView
                        style="@style/SettingSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="播完自动播放下一集" />
                </LinearLayout>

                <View
                    android:id="@+id/swAutoNext"
                    android:layout_width="44dp"
                    android:layout_height="24dp"
                    android:background="@drawable/bg_switch_off" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="46dp"
                android:layout_marginEnd="10dp"
                android:background="@color/line" />

            <LinearLayout
                android:id="@+id/btnClock"
                style="@style/SettingRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_clock" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/SettingTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="显示时间" />

                    <TextView
                        style="@style/SettingSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="播放器右上角显示当前时间" />
                </LinearLayout>

                <View
                    android:id="@+id/swClock"
                    android:layout_width="44dp"
                    android:layout_height="24dp"
                    android:background="@drawable/bg_switch_off" />
            </LinearLayout>
        </LinearLayout>

        <!-- 首页与直播 -->
        <TextView
            style="@style/SettingGroupTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/settings_group_gap"
            android:layout_marginBottom="8dp"
            android:text="首页与直播" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_setting_card"
            android:orientation="vertical"
            android:padding="6dp">

            <LinearLayout
                android:id="@+id/btnHomeMode"
                style="@style/SettingRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_home" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/SettingTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="首页内容" />

                    <TextView
                        style="@style/SettingSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="打开 App 后进入的页面" />
                </LinearLayout>

                <TextView
                    android:id="@+id/valHomeMode"
                    style="@style/SettingValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="影视" />

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="4dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chevron" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="46dp"
                android:layout_marginEnd="10dp"
                android:background="@color/line" />

            <LinearLayout
                android:id="@+id/btnLiveSources"
                style="@style/SettingRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_source" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/SettingTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="直播订阅源" />

                    <TextView
                        style="@style/SettingSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="支持 m3u / txt 订阅地址" />
                </LinearLayout>

                <TextView
                    android:id="@+id/valLiveSources"
                    style="@style/SettingValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="未添加" />

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="4dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chevron" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="46dp"
                android:layout_marginEnd="10dp"
                android:background="@color/line" />

            <LinearLayout
                android:id="@+id/btnLiveDecode"
                style="@style/SettingRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_decode" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/SettingTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="直播解码" />

                    <TextView
                        style="@style/SettingSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="自动 / 硬解 / 软解" />
                </LinearLayout>

                <TextView
                    android:id="@+id/valLiveDecode"
                    style="@style/SettingValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="自动" />

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="4dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chevron" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="46dp"
                android:layout_marginEnd="10dp"
                android:background="@color/line" />

            <LinearLayout
                android:id="@+id/btnLiveKernel"
                style="@style/SettingRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_kernel" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/SettingTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="直播内核" />

                    <TextView
                        style="@style/SettingSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="直播播放器内核选择" />
                </LinearLayout>

                <TextView
                    android:id="@+id/valLiveKernel"
                    style="@style/SettingValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Media3" />

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="4dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chevron" />
            </LinearLayout>
        </LinearLayout>

        <!-- 系统 -->
        <TextView
            style="@style/SettingGroupTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/settings_group_gap"
            android:layout_marginBottom="8dp"
            android:text="系统" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_setting_card"
            android:orientation="vertical"
            android:padding="6dp">

            <LinearLayout
                android:id="@+id/btnBoot"
                style="@style/SettingRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_boot" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/SettingTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="开机自动启动" />

                    <TextView
                        style="@style/SettingSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="开机后自动进入剧好看" />
                </LinearLayout>

                <TextView
                    android:id="@+id/valBoot"
                    style="@style/SettingValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="190dp"
                    android:text="已关闭" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="46dp"
                android:layout_marginEnd="10dp"
                android:background="@color/line" />

            <LinearLayout
                android:id="@+id/btnClearCache"
                style="@style/SettingRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_clean" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/SettingTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="清除播放缓存" />

                    <TextView
                        style="@style/SettingSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="释放播放占用的缓存空间" />
                </LinearLayout>

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="4dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chevron" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="46dp"
                android:layout_marginEnd="10dp"
                android:background="@color/line" />

            <LinearLayout
                android:id="@+id/btnClearRecords"
                style="@style/SettingRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_history" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/SettingTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="清空播放记录" />

                    <TextView
                        style="@style/SettingSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="清除回看列表与续播进度" />
                </LinearLayout>

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="4dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chevron" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="46dp"
                android:layout_marginEnd="10dp"
                android:background="@color/line" />

            <LinearLayout
                android:id="@+id/btnSponsor"
                style="@style/SettingRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_favorite" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/SettingTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="赞助作者" />

                    <TextView
                        style="@style/SettingSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="微信 / 支付宝扫码支持" />
                </LinearLayout>

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="4dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chevron" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/versionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:lineSpacingExtra="4dp"
            android:textColor="@color/text2"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/shopBrand"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_brand_bar"
            android:orientation="vertical"
            android:paddingTop="13dp"
            android:paddingBottom="13dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="开源项目 · 需自行配置 MoonTV / MoonTVPlus 服务端"
                android:textColor="@color/accent"
                android:textSize="12sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:gravity="center"
                android:letterSpacing="0.05"
                android:text="MIT License · 仅供学习交流"
                android:textColor="@color/text2"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
