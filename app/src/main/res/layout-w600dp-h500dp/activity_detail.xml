<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:paddingStart="44dp"
        android:paddingTop="30dp"
        android:paddingEnd="44dp"
        android:paddingBottom="18dp">

        <!-- 左栏：正方形画报 / 小窗播放 -->
        <LinearLayout
            android:layout_width="264dp"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="260dp"
                android:layout_height="260dp"
                android:background="@drawable/bg_media_card"
                android:clipToOutline="true">

                <ImageView
                    android:id="@+id/detailPoster"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_media_card"
                    android:clipToOutline="true"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop" />

                <FrameLayout
                    android:id="@+id/miniWrap"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_mini_card"
                    android:clipToOutline="true"
                    android:visibility="gone">

                    <androidx.media3.ui.PlayerView
                        android:id="@+id/miniPlayer"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        app:keep_content_on_player_reset="true"
                        app:resize_mode="fit"
                        app:surface_type="texture_view"
                        app:use_controller="false" />

                    <TextView
                        android:id="@+id/miniBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start|bottom"
                        android:layout_margin="10dp"
                        android:background="@drawable/bg_mini_badge"
                        android:paddingStart="9dp"
                        android:paddingTop="3dp"
                        android:paddingEnd="9dp"
                        android:paddingBottom="3dp"
                        android:text="小窗播放"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp" />
                </FrameLayout>
            </FrameLayout>

            <TextView
                android:id="@+id/detailMeta"
                android:layout_width="260dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:letterSpacing="0.02"
                android:textColor="@color/text2"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 右栏：信息与选集 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="34dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/detailTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/text"
                android:textSize="30sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipYear"
                    style="@style/InfoChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/chipType"
                    style="@style/InfoChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/chipRate"
                    style="@style/InfoChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/accent"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/detailSub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="@color/accent"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/detailDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:ellipsize="end"
                android:lineSpacingExtra="4dp"
                android:maxLines="2"
                android:textColor="@color/text2"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/btnFull"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/bg_icon_btn"
                    android:contentDescription="全屏播放"
                    android:focusable="true"
                    android:padding="11dp"
                    android:src="@drawable/ic_fullscreen" />

                <TextView
                    android:id="@+id/btnPlay"
                    style="@style/ActionButtonPrimary"
                    android:layout_width="wrap_content"
                    android:layout_height="46dp"
                    android:text="▶ 播放" />

                <TextView
                    android:id="@+id/btnFavorite"
                    style="@style/ActionButton"
                    android:layout_width="wrap_content"
                    android:layout_height="46dp"
                    android:text="♡ 收藏" />

                <TextView
                    android:id="@+id/btnRetest"
                    style="@style/ActionButton"
                    android:layout_width="wrap_content"
                    android:layout_height="46dp"
                    android:text="⇅ 重新测速" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:background="@color/line" />

            <TextView
                style="@style/SettingGroupTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="8dp"
                android:text="播放线路（测速）" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_setting_card"
                android:orientation="vertical"
                android:padding="8dp">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/sourceList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:scrollbars="none" />
            </LinearLayout>

            <TextView
                android:id="@+id/episodeLabel"
                style="@style/SettingGroupTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                android:text="选集" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="0dp"
                android:layout_weight="1"
                android:background="@drawable/bg_setting_card"
                android:orientation="vertical"
                android:padding="8dp">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/episodeList"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingBottom="10dp"
                    android:scrollbars="none" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/detailLoading"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="center"
        android:indeterminateTint="@color/accent" />

    <TextView
        android:id="@+id/detailStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:textColor="@color/text2"
        android:textSize="15sp"
        android:visibility="gone" />
</FrameLayout>
